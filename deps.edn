{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/compiler is a TEST-ONLY dependency: it is needed by the tests
         ;; that compile src/kotoba/rtx_native.kotoba and require it to agree with
         ;; src/kotoba/rtx_native.cljc (ADR 0001 as amended, and ADR-2608134800 in
         ;; com-junkawasaki/root). Consumers require only the .cljc and must not be
         ;; made to drag the compiler in behind it — kotoba-lang/css, /dsl-core,
         ;; /async and /postfx set the same boundary.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       :git/sha "16215e00e8709a54b260477ef440129e26b07595"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
